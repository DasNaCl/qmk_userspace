# This adds module functionality to your keyboard (files found in users/halcyon_modules)
USER_NAME := halcyon_modules
MOUSEKEY_ENABLE = yes
TAP_DANCE_ENABLE = yes
UNICODEMAP_ENABLE = yes

# like vim
LEADER_ENABLE = yes

# allow typing only capital letters until 5secs of idle or space is pressed
CAPS_WORD_ENABLE = yes

# When pressed, will lock the current layer so that the layer switch need not be held
# https://docs.qmk.fm/features/layer_lock
LAYER_LOCK_ENABLE= yes

ONESHOT_TAP_TOGGLE = yes

